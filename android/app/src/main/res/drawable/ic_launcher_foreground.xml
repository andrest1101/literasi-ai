<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground adaptive icon: glyph buku + pohon sirkuit dari logo.
     Glyph berasal dari raster logo sumber (bukan vector hasil tracing) supaya
     bentuknya identik dengan brand. Bitmap disediakan 108 dp di setiap
     kerapatan (drawable-*dpi/ic_launcher_foreground_glyph.png, 432 px pada
     xxxhdpi), jadi launcher dan splash Android 12 tetap tajam. Wrapper
     layer-list dipertahankan agar nama resource stabil untuk manifest,
     mipmap-anydpi-v26, dan windowSplashScreenAnimatedIcon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_foreground_glyph" />
    </item>
</layer-list>
