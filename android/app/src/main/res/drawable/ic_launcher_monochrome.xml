<?xml version="1.0" encoding="utf-8"?>
<!-- Layer monochrome (Android 13 themed icon): siluet glyph dalam satu tinta.
     Sistem yang memberi warna; alpha inilah siluetnya. Bayangan halus pada
     logo sumber sudah dibuang oleh generator agar tema tidak terlihat kabur. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_monochrome_glyph" />
    </item>
</layer-list>
