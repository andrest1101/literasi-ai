<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+: splash screen bawaan platform. Bidang brand yang sama dengan
         SplashScreen Flutter (#1A73E8) dan mark vektor, jadi transisi ke frame
         pertama tidak pernah menampilkan layar putih. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_primary</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
