<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+: splash screen bawaan platform. Bidang brand yang sama dengan
         SplashScreen Flutter (#1A73E8) dan mark putih (@drawable/splash_mark),
         jadi transisi ke frame pertama tidak pernah menampilkan layar putih
         maupun glyph berwarna yang menyatu dengan bidang biru. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_primary</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
    </style>
</resources>
