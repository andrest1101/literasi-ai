rules_version = '2';

// LiterasiAI — owner-only per UID.
// User hanya boleh baca/tulis datanya sendiri di bawah users/{uid}.
// Tanpa login: semua ditolak (app menampilkan empty state, bukan crash).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
